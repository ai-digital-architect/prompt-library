```typescript
// Example: Open Source vs. Commercial AI Tool Decision Matrix
interface EvaluationCriterion {
  name: string;
  description: string;
  weight: number; // 1-10
}

interface ToolOption {
  name: string;
  type: 'open_source' | 'commercial';
  description: string;
}

interface ScoreCard {
  criterion: string;
  score: number; // 1-10
  notes: string;
}

class AIToolEvaluator {
  private criteria: EvaluationCriterion[] = [];
  private options: ToolOption[] = [];
  private scores: Map<string, Map<string, ScoreCard>> = new Map();
  
  constructor(private projectName: string, private teamContext: string) {}
  
  public addCriterion(criterion: EvaluationCriterion): void {
    // Validate weight
    if (criterion.weight < 1 || criterion.weight > 10) {
      throw new Error("Criterion weight must be between 1 and 10");
    }
    
    this.criteria.push(criterion);
  }
  
  public addOption(option: ToolOption): void {
    this.options.push(option);
    this.scores.set(option.name, new Map());
  }
  
  public scoreTool(optionName: string, criterionName: string, score: number, notes: string = ""): void {
    // Validate option and criterion exist
    const option = this.options.find(o => o.name === optionName);
    const criterion = this.criteria.find(c => c.name === criterionName);
    
    if (!option) {
      throw new Error(`Option "${optionName}" not found`);
    }
    
    if (!criterion) {
      throw new Error(`Criterion "${criterionName}" not found`);
    }
    
    // Validate score
    if (score < 1 || score > 10) {
      throw new Error("Score must be between 1 and 10");
    }
    
    // Record score
    const optionScores = this.scores.get(optionName);
    if (optionScores) {
      optionScores.set(criterionName, { criterion: criterionName, score, notes });
    }
  }
  
  public calculateResults(): { 
    rankings: Array<{ option: ToolOption, totalScore: number, weightedScore: number }>,
    criteriaBreakdown: Map<string, Array<{ option: string, score: number, weighted: number }>>
  } {
    const rankings: Array<{ option: ToolOption, totalScore: number, weightedScore: number }> = [];
    const criteriaBreakdown: Map<string, Array<{ option: string, score: number, weighted: number }>> = new Map();
    
    // Initialize criteria breakdown
    for (const criterion of this.criteria) {
      criteriaBreakdown.set(criterion.name, []);
    }
    
    // Calculate scores for each option
    for (const option of this.options) {
      const optionScores = this.scores.get(option.name);
      if (!optionScores) continue;
      
      let totalScore = 0;
      let totalWeight = 0;
      let weightedScore = 0;
      
      for (const criterion of this.criteria) {
        const scoreCard = optionScores.get(criterion.name);
        
        if (scoreCard) {
          const score = scoreCard.score;
          const weight = criterion.weight;
          
          totalScore += score;
          totalWeight += weight;
          weightedScore += score * weight;
          
          // Add to criteria breakdown
          const breakdown = criteriaBreakdown.get(criterion.name);
          if (breakdown) {
            breakdown.push({
              option: option.name,
              score,
              weighted: score * weight
            });
          }
        }
      }
      
      // Normalize weighted score to 0-10 scale
      const normalizedWeightedScore = totalWeight > 0 ? weightedScore / totalWeight * 10 : 0;
      
      rankings.push({
        option,
        totalScore,
        weightedScore: normalizedWeightedScore
      });
    }
    
    // Sort rankings by weighted score (descending)
    rankings.sort((a, b) => b.weightedScore - a.weightedScore);
    
    // Sort criteria breakdowns
    for (const [criterionName, breakdown] of criteriaBreakdown.entries()) {
      breakdown.sort((a, b) => b.weighted - a.weighted);
    }
    
    return { rankings, criteriaBreakdown };
  }
  
  public generateReport(): string {
    const { rankings, criteriaBreakdown } = this.calculateResults();
    
    let report = `# AI Tool Evaluation Report\n\n`;
    report += `## Project: ${this.projectName}\n`;
    report += `## Team Context: ${this.teamContext}\n\n`;
    
    // Overall rankings
    report += `## Overall Rankings\n\n`;
    report += `| Rank | Tool | Type | Weighted Score | Raw Score |\n`;
    report += `|------|------|------|---------------|----------|\n`;
    
    rankings.forEach((ranking, index) => {
      report += `| ${index + 1} | ${ranking.option.name} | ${ranking.option.type} | ${ranking.weightedScore.toFixed(2)} | ${ranking.totalScore} |\n`;
    });
    
    report += `\n`;
    
    // Criteria breakdown
    report += `## Criteria Breakdown\n\n`;
    
    for (const criterion of this.criteria) {
      report += `### ${criterion.name} (Weight: ${criterion.weight})\n\n`;
      report += `${criterion.description}\n\n`;
      
      const breakdown = criteriaBreakdown.get(criterion.name);
      if (breakdown && breakdown.length > 0) {
        report += `| Tool | Score | Weighted Score |\n`;
        report += `|------|-------|---------------|\n`;
        
        breakdown.forEach(item => {
          report += `| ${item.option} | ${item.score} | ${item.weighted.toFixed(2)} |\n`;
        });
        
        report += `\n`;
      } else {
        report += `No scores recorded for this criterion.\n\n`;
      }
    }
    
    // Tool details
    report += `## Tool Details\n\n`;
    
    for (const option of this.options) {
      report += `### ${option.name} (${option.type})\n\n`;
      report += `${option.description}\n\n`;
      
      const optionScores = this.scores.get(option.name);
      if (optionScores && optionScores.size > 0) {
        report += `| Criterion | Score | Notes |\n`;
        report += `|-----------|-------|-------|\n`;
        
        for (const criterion of this.criteria) {
          const scoreCard = optionScores.get(criterion.name);
          if (scoreCard) {
            report += `| ${criterion.name} | ${scoreCard.score} | ${scoreCard.notes} |\n`;
          }
        }
        
        report += `\n`;
      }
    }
    
    // Recommendations
    report += `## Recommendations\n\n`;
    
    if (rankings.length > 0) {
      const topOption = rankings[0].option;
      report += `Based on the evaluation, **${topOption.name}** (${topOption.type}) appears to be the best fit for this project with a weighted score of ${rankings[0].weightedScore.toFixed(2)}.\n\n`;
      
      // Find areas where top option scored poorly
      const weaknesses: string[] = [];
      const optionScores = this.scores.get(topOption.name);
      
      if (optionScores) {
        for (const criterion of this.criteria) {
          const scoreCard = optionScores.get(criterion.name);
          if (scoreCard && scoreCard.score <= 5 && criterion.weight >= 7) {
            weaknesses.push(`- **${criterion.name}**: Scored only ${scoreCard.score}/10 despite high importance (weight: ${criterion.weight})`);
          }
        }
      }
      
      if (weaknesses.length > 0) {
        report += `### Areas of Concern\n\n`;
        report += `While ${topOption.name} ranked highest overall, consider these potential issues:\n\n`;
        report += weaknesses.join('\n');
        report += `\n\n`;
      }
      
      // Compare open source vs commercial options
      const topOpenSource = rankings.find(r => r.option.type === 'open_source');
      const topCommercial = rankings.find(r => r.option.type === 'commercial');
      
      if (topOpenSource && topCommercial) {
        const scoreDiff = Math.abs(topOpenSource.weightedScore - topCommercial.weightedScore);
        
        if (scoreDiff < 1.0) {
          report += `### Open Source vs Commercial Consideration\n\n`;
          report += `The top open source option (${topOpenSource.option.name}) and commercial option (${topCommercial.option.name}) scored very similarly `;
          report += `(${topOpenSource.weightedScore.toFixed(2)} vs ${topCommercial.weightedScore.toFixed(2)}). `;
          report += `Consider running a limited pilot with both options before making a final decision.\n\n`;
        }
      }
    } else {
      report += `Insufficient data to make a recommendation. Please complete the evaluation for all tools and criteria.\n\n`;
    }
    
    return report;
  }
}

